<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Telemetry-SQLite</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Telemetry-SQLite models an edge gateway or RMS node buffering IoT sensor telemetry in SQLite: 256 simulated devices, WAL journal, batched transactions and JSON payloads. Ingest measures rows inserted per second, Query measures time-window aggregate queries per second over a 500k-row store, and Mixed interleaves both. Uses only the Python standard library.</Description>
    <ResultScale>Rows/sec</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>System</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>python</ExternalDependencies>
    <EnvironmentSize>0.2</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, Edge, IoT, Database</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Workload</DisplayName>
      <Identifier>workload</Identifier>
      <Menu>
        <Entry>
          <Name>Ingest</Name>
          <Value>ingest</Value>
        </Entry>
        <Entry>
          <Name>Query</Name>
          <Value>query</Value>
        </Entry>
        <Entry>
          <Name>Mixed</Name>
          <Value>mixed</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
