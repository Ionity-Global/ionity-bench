<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Latency-RT</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Latency-RT measures timer wake-up jitter for soft real-time control loops such as SCADA polling, RMS heartbeats and sensor sampling. A thread sleeps on a 1 ms period for 10 seconds and records how late each wake-up arrives; lower is better. Run with an idle system, or alongside another workload, to characterise scheduler behaviour.</Description>
    <ResultScale>Microseconds</ResultScale>
    <Proportion>LIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>System</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>build-utilities</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, Edge, RealTime</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Metric</DisplayName>
      <Identifier>metric</Identifier>
      <Menu>
        <Entry>
          <Name>Maximum Latency</Name>
          <Value>max</Value>
        </Entry>
        <Entry>
          <Name>99th Percentile</Name>
          <Value>p99</Value>
        </Entry>
        <Entry>
          <Name>Average</Name>
          <Value>avg</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
