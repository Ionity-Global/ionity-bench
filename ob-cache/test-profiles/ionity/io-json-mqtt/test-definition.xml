<!--Ionity Bench 1.0.0 (Centurion) on Phoronix Test Suite | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - AEDI | Policy 986 AED | GPL-3.0-or-later-->
<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-JSON-MQTT</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-JSON-MQTT round-trips MQTT-style JSON telemetry (encode, decode, validate) as a gateway, broker bridge or RMS collector would. Small is a single ~180 byte sensor reading, Large is a batched 100-reading uplink (~12 KB), and Sparkplug is a Sparkplug-B style metric list with aliases and datatypes. Uses only the Python standard library.</Description>
    <ResultScale>Messages/sec</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Processor</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>python</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, Edge, IoT, MQTT</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Payload</DisplayName>
      <Identifier>payload</Identifier>
      <Menu>
        <Entry>
          <Name>Small Reading</Name>
          <Value>small</Value>
        </Entry>
        <Entry>
          <Name>Large Batch</Name>
          <Value>large</Value>
        </Entry>
        <Entry>
          <Name>Sparkplug-B</Name>
          <Value>sparkplug</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
