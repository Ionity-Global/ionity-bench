<!--Ionity Bench 1.0.0 (Centurion) on Phoronix Test Suite | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - AEDI | Policy 986 AED | GPL-3.0-or-later-->
<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Core</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Core is a mixed integer / floating-point / branch CPU kernel designed for edge-class processors (Raspberry Pi, Radxa, ESP32-class Linux SoCs through to x86 servers). Each work unit combines xorshift PRNG + FNV-1a hashing, Mandelbrot escape-time iteration and a prime sieve; the score is work units per second across the selected threads.</Description>
    <ResultScale>ION Points</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Processor</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>build-utilities</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, SMP, Edge</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Threads</DisplayName>
      <Identifier>threads</Identifier>
      <Menu>
        <Entry>
          <Name>All CPU Cores</Name>
          <Value>0</Value>
        </Entry>
        <Entry>
          <Name>Single Core</Name>
          <Value>1</Value>
        </Entry>
        <Entry>
          <Name>Four Cores</Name>
          <Value>4</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
