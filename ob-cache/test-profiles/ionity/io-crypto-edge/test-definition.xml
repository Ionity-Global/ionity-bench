<!--Ionity Bench 1.0.0 (Centurion) on Phoronix Test Suite | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - AEDI | Policy 986 AED | GPL-3.0-or-later-->
<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Crypto-Edge</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Crypto-Edge measures hashing and message-authentication throughput relevant to TLS, OTA firmware verification and signed telemetry on edge devices: SHA-256, SHA-512 and BLAKE2b over 1 MiB blocks, HMAC-SHA256 over 256-byte messages, and PBKDF2-HMAC-SHA256 key derivation (100k iterations). Uses the Python standard library (OpenSSL-backed where available).</Description>
    <ResultScale>MB/s</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Processor</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>python</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, Edge, Security</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Algorithm</DisplayName>
      <Identifier>algorithm</Identifier>
      <Menu>
        <Entry>
          <Name>SHA-256</Name>
          <Value>sha256</Value>
        </Entry>
        <Entry>
          <Name>SHA-512</Name>
          <Value>sha512</Value>
        </Entry>
        <Entry>
          <Name>BLAKE2b</Name>
          <Value>blake2b</Value>
        </Entry>
        <Entry>
          <Name>HMAC-SHA256 Small Messages</Name>
          <Value>hmac-small</Value>
        </Entry>
        <Entry>
          <Name>PBKDF2 Key Derivation</Name>
          <Value>pbkdf2</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
