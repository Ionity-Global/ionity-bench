<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Thermal-Sustain</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Thermal-Sustain detects thermal throttling on passively cooled and enclosed edge hardware. All cores run an FMA-heavy kernel for the chosen duration while throughput is sampled every second; the result is the sustained throughput of the final 20% of the run as a percentage of the peak reached in the first 10%. 100% means no throttling. SoC temperature is logged where the Linux thermal zone is exposed.</Description>
    <ResultScale>Sustained Efficiency %</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>1</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Processor</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>build-utilities</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, SMP, Edge, Thermal</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Duration</DisplayName>
      <Identifier>duration</Identifier>
      <Menu>
        <Entry>
          <Name>60 Seconds</Name>
          <Value>60</Value>
        </Entry>
        <Entry>
          <Name>3 Minutes</Name>
          <Value>180</Value>
        </Entry>
        <Entry>
          <Name>10 Minutes</Name>
          <Value>600</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
