<!--Ionity Bench 1.0.0 (Centurion) on Phoronix Test Suite | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - AEDI | Policy 986 AED | GPL-3.0-or-later-->
<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-Storage-Edge</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-Storage-Edge exercises the storage behaviour that matters on SD cards, eMMC, NVMe HATs and SATA carriers used in edge nodes: durable 4 KiB random writes with fsync (SQLite/WAL commits, log appends), 4 KiB random reads across a 512 MiB file with the page cache dropped, and 1 MiB sequential writes. The scratch file is created in the test install directory and removed afterwards.</Description>
    <ResultScale>IOPS</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Disk</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>python</ExternalDependencies>
    <EnvironmentSize>0.6</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, Edge, Storage</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Workload</DisplayName>
      <Identifier>workload</Identifier>
      <Menu>
        <Entry>
          <Name>Durable 4K Random Write + fsync</Name>
          <Value>fsync-write</Value>
        </Entry>
        <Entry>
          <Name>4K Random Read</Name>
          <Value>rand-read</Value>
        </Entry>
        <Entry>
          <Name>1MB Sequential Write</Name>
          <Value>seq-write</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
