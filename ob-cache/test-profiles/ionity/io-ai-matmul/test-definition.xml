<!--Ionity Bench 1.0.0 (Centurion) on Phoronix Test Suite | (c) 2018-2026 Antwerp Designs | Ionity (Pty) Ltd - AEDI | Policy 986 AED | GPL-3.0-or-later-->
<PhoronixTestSuite>
  <TestInformation>
    <Title>Ionity IO-AI-MatMul</Title>
    <AppVersion>1.0.0</AppVersion>
    <Description>Ionity Bench IO-AI-MatMul is an edge-inference proxy: blocked 512x512 dense matrix multiplication in FP32 and quantised INT8 (int32 accumulate) across all cores, the primitive that dominates CNN and transformer inference on CPUs without an NPU. INT8 results are reported as GOPS.</Description>
    <ResultScale>GFLOPS</ResultScale>
    <Proportion>HIB</Proportion>
    <TimesToRun>3</TimesToRun>
  </TestInformation>
  <TestProfile>
    <Version>1.0.0</Version>
    <SupportedPlatforms>Linux, BSD, MacOSX, Solaris</SupportedPlatforms>
    <SoftwareType>Benchmark</SoftwareType>
    <TestType>Processor</TestType>
    <License>Free</License>
    <Status>Verified</Status>
    <ExternalDependencies>build-utilities</ExternalDependencies>
    <EnvironmentSize>0.01</EnvironmentSize>
    <ProjectURL>https://github.com/Ionity-Global/ionity-bench</ProjectURL>
    <InternalTags>Ionity, SMP, Edge, AI</InternalTags>
    <Maintainer>Johan Wilhelm van Antwerp - Ionity (Pty) Ltd</Maintainer>
  </TestProfile>
  <TestSettings>
    <Default>
      <AllowCacheShare>TRUE</AllowCacheShare>
    </Default>
    <Option>
      <DisplayName>Precision</DisplayName>
      <Identifier>precision</Identifier>
      <Menu>
        <Entry>
          <Name>FP32</Name>
          <Value>fp32</Value>
        </Entry>
        <Entry>
          <Name>INT8</Name>
          <Value>int8</Value>
        </Entry>
      </Menu>
    </Option>
  </TestSettings>
</PhoronixTestSuite>
