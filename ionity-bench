if which realpath >/dev/null 2>&1 ; then
	IONITY_BENCH_DIR=$(dirname "$(realpath "$0")")
else
	IONITY_BENCH_DIR=$(cd "$(dirname "$0")" && pwd)
fi

# Prefer the sibling engine launcher (git checkout / tarball), fall back to a system install.
if [ -x "$IONITY_BENCH_DIR/phoronix-test-suite" ]; then
	ENGINE="$IONITY_BENCH_DIR/phoronix-test-suite"
elif [ -x /usr/share/phoronix-test-suite/phoronix-test-suite ]; then
	ENGINE=/usr/share/phoronix-test-suite/phoronix-test-suite
else
	ENGINE=phoronix-test-suite
fi

export IONITY_BENCH=1
export IONITY_BENCH_LAUNCHER="$0"

# Convenience aliases: `ionity-bench edge-node` == `phoronix-test-suite benchmark ionity/edge-node`
case "$1" in
	""|help|--help|-h)
		exec "$ENGINE" ionity
		;;
	edge-node|iot-gateway|ai-edge|storage|timeseries-db|server-rms|workstation-design|quick-check|full-spectrum|power-thermal)
		SUITE="ionity/$1"; shift
		exec "$ENGINE" benchmark "$SUITE" "$@"
		;;
	io-*)
		TEST="ionity/$1"; shift
		exec "$ENGINE" benchmark "$TEST" "$@"
		;;
	*)
		exec "$ENGINE" "$@"
		;;
esac
